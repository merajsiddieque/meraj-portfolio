PROJECT_NAME="Meraj Alam AI Portfolio"
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
# Supabase connection URI format:
# postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Leave as sqlite:///./local_portfolio.db for immediate local testing without cloud config
DATABASE_URL=sqlite:///./local_portfolio.db

# Supabase Cloud Configuration
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key
SUPABASE_ANON_KEY=your_supabase_anon_key

# Google Gemini API key for "Ask Meraj" Chatbot agent
GEMINI_API_KEY=your_gemini_api_key

# GitHub profile username to pull telemetry and repository stats
GITHUB_USERNAME=merajsiddieque
GITHUB_TOKEN=

# Allowed origins for CORS (comma separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
